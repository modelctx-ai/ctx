{
  "name": "@modelctx-ai/ctx-claude-code",
  "version": "0.3.0",
  "description": "把 Claude Code（claude -p）接成 ctx 的 harness：它自己跑循环，轨迹实时写进会话日志，工具经 MCP 回到 ctx 的执行环境。",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "harness",
    "mcp"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelctx-ai/ctx.git",
    "directory": "packages/claude-code"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "@modelctx-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@modelctx-ai/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack"
  },
  "peerDependencies": {
    "@modelctx-ai/ctx-mcp": "workspace:^",
    "@modelctx-ai/ctx-protocol": "workspace:^"
  },
  "devDependencies": {
    "@modelctx-ai/ctx": "workspace:^",
    "@modelctx-ai/ctx-mcp": "workspace:^",
    "@modelctx-ai/ctx-protocol": "workspace:^"
  }
}
