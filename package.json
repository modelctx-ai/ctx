{
  "name": "ctx-workspace",
  "private": true,
  "type": "module",
  "description": "ctx：模型上下文管理的核心框架与服务。",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@modelctx-ai/source --test-reporter=spec --test \"packages/*/src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm format:check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
