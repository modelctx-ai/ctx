{
  "name": "ctx-workspace",
  "private": true,
  "type": "module",
  "description": "ctx：模型上下文管理的核心框架与服务。",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint --deny-warnings",
    "test": "vp test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check --deny-warnings && vp test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
