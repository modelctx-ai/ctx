{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelctx.ai/schema/protocol/0.3",
  "title": "ctx protocol 0.3",
  "description": "线上 JSON 形状。名字和 @modelctx-ai/ctx-protocol 的类型名一样；只描述过线的形状。",
  "$defs": {
    "JsonValue": {
      "description": "任何 JSON 值"
    },
    "JsonObject": {
      "type": "object"
    },
    "ErrorInfo": {
      "type": "object",
      "description": "跨边界的错误：`{ error: ErrorInfo }`",
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "statusCode": {
          "type": "integer"
        },
        "responseBody": {
          "type": "string"
        }
      },
      "required": ["message"],
      "additionalProperties": false
    },
    "MessageProviderOptions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "ToolFileData": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "data"
            },
            "data": {
              "type": "string"
            }
          },
          "required": ["type", "data"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": ["type", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "reference"
            },
            "reference": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": ["type", "reference"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        }
      ]
    },
    "TextPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        },
        "providerOptions": {
          "$ref": "#/$defs/MessageProviderOptions"
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "FilePart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "file"
        },
        "mediaType": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ToolFileData"
        },
        "filename": {
          "type": "string"
        },
        "providerOptions": {
          "$ref": "#/$defs/MessageProviderOptions"
        }
      },
      "required": ["type", "mediaType", "data"],
      "additionalProperties": false
    },
    "ReasoningPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "reasoning"
        },
        "text": {
          "type": "string"
        },
        "providerOptions": {
          "$ref": "#/$defs/MessageProviderOptions"
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "ReasoningFilePart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "reasoning-file"
        },
        "mediaType": {
          "type": "string"
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "data"
                },
                "data": {
                  "type": "string"
                }
              },
              "required": ["type", "data"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "url"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": ["type", "url"],
              "additionalProperties": false
            }
          ]
        },
        "providerOptions": {
          "$ref": "#/$defs/MessageProviderOptions"
        }
      },
      "required": ["type", "mediaType", "data"],
      "additionalProperties": false
    },
    "CustomPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "custom"
        },
        "kind": {
          "type": "string"
        },
        "providerOptions": {
          "$ref": "#/$defs/MessageProviderOptions"
        }
      },
      "required": ["type", "kind"],
      "additionalProperties": false
    },
    "ToolCallPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool-call"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": {},
        "providerExecuted": {
          "type": "boolean"
        },
        "providerOptions": {
          "$ref": "#/$defs/MessageProviderOptions"
        }
      },
      "required": ["type", "id", "name", "input"],
      "additionalProperties": false
    },
    "ToolResultPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool-result"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/ToolOutput"
        },
        "providerOptions": {
          "$ref": "#/$defs/MessageProviderOptions"
        }
      },
      "required": ["type", "id", "name", "output"],
      "additionalProperties": false
    },
    "ToolApprovalRequestPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool-approval-request"
        },
        "approvalId": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "isAutomatic": {
          "type": "boolean"
        },
        "signature": {
          "type": "string"
        },
        "inputSchemaInput": {}
      },
      "required": ["type", "approvalId", "callId"],
      "additionalProperties": false
    },
    "ToolApprovalResponsePart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool-approval-response"
        },
        "approvalId": {
          "type": "string"
        },
        "approved": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "providerExecuted": {
          "type": "boolean"
        }
      },
      "required": ["type", "approvalId", "approved"],
      "additionalProperties": false
    },
    "MessageContent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/TextPart"
              },
              {
                "$ref": "#/$defs/FilePart"
              }
            ]
          }
        }
      ]
    },
    "Message": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "system"
            },
            "content": {
              "type": "string"
            },
            "providerOptions": {
              "$ref": "#/$defs/MessageProviderOptions"
            }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "user"
            },
            "content": {
              "$ref": "#/$defs/MessageContent"
            },
            "providerOptions": {
              "$ref": "#/$defs/MessageProviderOptions"
            }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "assistant"
            },
            "content": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/TextPart"
                      },
                      {
                        "$ref": "#/$defs/FilePart"
                      },
                      {
                        "$ref": "#/$defs/ReasoningPart"
                      },
                      {
                        "$ref": "#/$defs/ReasoningFilePart"
                      },
                      {
                        "$ref": "#/$defs/CustomPart"
                      },
                      {
                        "$ref": "#/$defs/ToolCallPart"
                      },
                      {
                        "$ref": "#/$defs/ToolResultPart"
                      },
                      {
                        "$ref": "#/$defs/ToolApprovalRequestPart"
                      }
                    ]
                  }
                }
              ]
            },
            "providerOptions": {
              "$ref": "#/$defs/MessageProviderOptions"
            }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "tool"
            },
            "content": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/ToolResultPart"
                  },
                  {
                    "$ref": "#/$defs/ToolApprovalResponsePart"
                  }
                ]
              }
            },
            "providerOptions": {
              "$ref": "#/$defs/MessageProviderOptions"
            }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        }
      ]
    },
    "MessageEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "v": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        },
        "at": {
          "type": "number"
        },
        "type": {
          "const": "message"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "key": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "meta": {
          "type": "object"
        }
      },
      "required": ["id", "session", "v", "seq", "at", "type", "message"],
      "additionalProperties": false
    },
    "EventEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "v": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        },
        "at": {
          "type": "number"
        },
        "type": {
          "const": "event"
        },
        "kind": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "meta": {
          "type": "object"
        },
        "text": {
          "type": "string"
        },
        "data": {}
      },
      "required": ["id", "session", "v", "seq", "at", "type", "kind"],
      "additionalProperties": false
    },
    "SummaryEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "v": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        },
        "at": {
          "type": "number"
        },
        "type": {
          "const": "summary"
        },
        "text": {
          "type": "string"
        },
        "covers": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "meta": {
          "type": "object"
        }
      },
      "required": ["id", "session", "v", "seq", "at", "type", "text", "covers"],
      "additionalProperties": false
    },
    "Entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/MessageEntry"
        },
        {
          "$ref": "#/$defs/EventEntry"
        },
        {
          "$ref": "#/$defs/SummaryEntry"
        }
      ]
    },
    "NewEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "message"
            },
            "message": {
              "$ref": "#/$defs/Message"
            },
            "id": {
              "type": "string"
            },
            "at": {
              "type": "number"
            },
            "key": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "meta": {
              "type": "object"
            }
          },
          "required": ["type", "message"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "event"
            },
            "kind": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "at": {
              "type": "number"
            },
            "key": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "meta": {
              "type": "object"
            },
            "text": {
              "type": "string"
            },
            "data": {}
          },
          "required": ["type", "kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "summary"
            },
            "text": {
              "type": "string"
            },
            "covers": {
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "at": {
              "type": "number"
            },
            "key": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "meta": {
              "type": "object"
            }
          },
          "required": ["type", "text", "covers"],
          "additionalProperties": false
        }
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": {}
      },
      "required": ["id", "name", "input"],
      "additionalProperties": false
    },
    "ToolContentPart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "file"
            },
            "mediaType": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/ToolFileData"
            },
            "filename": {
              "type": "string"
            }
          },
          "required": ["type", "mediaType", "data"],
          "additionalProperties": false
        }
      ]
    },
    "ToolOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "json"
            },
            "value": {}
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "content"
            },
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ToolContentPart"
              }
            }
          },
          "required": ["type", "parts"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "error"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "data": {}
          },
          "required": ["type", "message"],
          "additionalProperties": false
        }
      ]
    },
    "ToolDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "inputSchema": {
          "type": "object"
        },
        "executor": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "inputSchema", "executor"],
      "additionalProperties": false
    },
    "ToolSelection": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "number"
        },
        "outputTokens": {
          "type": "number"
        },
        "totalTokens": {
          "type": "number"
        },
        "cacheReadTokens": {
          "type": "number"
        },
        "cacheWriteTokens": {
          "type": "number"
        },
        "reasoningTokens": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "StopReason": {
      "enum": ["end_turn", "max_steps", "max_tokens", "max_budget", "requires_action", "aborted", "error"]
    },
    "CallSettings": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number"
        },
        "maxOutputTokens": {
          "type": "integer"
        },
        "topP": {
          "type": "number"
        },
        "topK": {
          "type": "number"
        },
        "presencePenalty": {
          "type": "number"
        },
        "frequencyPenalty": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "stopSequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxRetries": {
          "type": "integer"
        },
        "timeoutMs": {
          "type": "number"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "providerOptions": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "WindowOptions": {
      "type": "object",
      "properties": {
        "maxMessages": {
          "type": "integer"
        },
        "maxTokens": {
          "type": "number"
        },
        "truncate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ContextSpec": {
      "type": "object",
      "properties": {
        "facts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "placement": {
                  "enum": ["instructions", "prompt"]
                },
                "heading": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "projection": {
          "type": "string"
        },
        "overflow": {
          "type": "object",
          "properties": {
            "maxTokens": {
              "type": "number"
            },
            "strategy": {
              "enum": ["compact", "trim", "error"]
            },
            "compact": {
              "type": "object",
              "properties": {
                "keep": {
                  "type": "integer"
                },
                "minimum": {
                  "type": "integer"
                },
                "instructions": {
                  "type": "string"
                },
                "maxInputTokens": {
                  "type": "number"
                },
                "maxOutputTokens": {
                  "type": "integer"
                },
                "timeoutMs": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["maxTokens"],
          "additionalProperties": false
        },
        "inherit": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            },
            "upTo": {
              "type": "integer"
            }
          },
          "required": ["session"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AgentSpec": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "模型名：跨边界时只能是名字"
        },
        "name": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "tools": {
          "$ref": "#/$defs/ToolSelection"
        },
        "maxSteps": {
          "type": "integer"
        },
        "window": {
          "$ref": "#/$defs/WindowOptions"
        },
        "context": {
          "$ref": "#/$defs/ContextSpec"
        },
        "settings": {
          "$ref": "#/$defs/CallSettings"
        },
        "version": {
          "type": "string"
        },
        "output": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "object"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": ["schema"],
          "additionalProperties": false
        },
        "toolChoice": {
          "anyOf": [
            {
              "enum": ["auto", "none", "required"]
            },
            {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string"
                }
              },
              "required": ["tool"],
              "additionalProperties": false
            }
          ]
        },
        "permissions": {
          "type": "object",
          "properties": {
            "default": {
              "$ref": "#/$defs/ToolPermission"
            },
            "tools": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ToolPermission"
              }
            }
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "maxTotalTokens": {
              "type": "number"
            },
            "maxDurationMs": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["model"],
      "additionalProperties": false
    },
    "ToolPermission": {
      "enum": ["allow", "ask", "deny"]
    },
    "RunParent": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "toolCallId": {
